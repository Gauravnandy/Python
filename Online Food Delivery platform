from enum import Enum
from collections import defaultdict


# Order Status Enum
class OrderStatus(Enum):
    PLACED = "placed"
    PREPARING = "preparing"
    OUT_FOR_DELIVERY = "out_for_delivery"
    DELIVERED = "delivered"
    CANCELLED = "cancelled"


# Order Class
class Order:
    def __init__(self, order_id, restaurant_id, customer_id, value, distance):
        self.order_id = order_id
        self.restaurant_id = restaurant_id
        self.customer_id = customer_id
        self.value = value
        self.distance = distance
        self.status = OrderStatus.PLACED

    def update_status(self, new_status):
        valid_flow = {
            OrderStatus.PLACED: [OrderStatus.PREPARING, OrderStatus.CANCELLED],
            OrderStatus.PREPARING: [OrderStatus.OUT_FOR_DELIVERY, OrderStatus.CANCELLED],
            OrderStatus.OUT_FOR_DELIVERY: [OrderStatus.DELIVERED],
        }

        if self.status in valid_flow and new_status in valid_flow[self.status]:
            self.status = new_status
        else:
            print(f"Invalid status transition from {self.status} to {new_status}")

    def is_active(self):
        return self.status in {
            OrderStatus.PLACED,
            OrderStatus.PREPARING,
            OrderStatus.OUT_FOR_DELIVERY,
        }

    def is_closed(self):
        return self.status in {
            OrderStatus.DELIVERED,
            OrderStatus.CANCELLED,
        }

    def __str__(self):
        return f"Order({self.order_id}, Status={self.status.value})"


# Order Manager Class
class OrderManager:
