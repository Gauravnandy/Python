from enum import Enum
from datetime import datetime, timedelta
from collections import defaultdict


# ---------------- ENUM FOR ORDER STATUS ----------------
class OrderStatus(Enum):
    PLACED = "placed"
    PREPARING = "preparing"
    OUT_FOR_DELIVERY = "out_for_delivery"
    DELIVERED = "delivered"
    CANCELLED = "cancelled"

    def is_active(self):
        return self in {
            OrderStatus.PLACED,
            OrderStatus.PREPARING,
            OrderStatus.OUT_FOR_DELIVERY
        }

    def is_closed(self):
        return self in {
            OrderStatus.DELIVERED,
            OrderStatus.CANCELLED
        }


# ---------------- ORDER CLASS ----------------
class Order:
    def __init__(self, order_id, restaurant_id, customer_id, order_value, distance):
        self.order_id = order_id
        self.restaurant_id = restaurant_id
        self.customer_id = customer_id
        self.order_value = order_value
        self.distance = distance
        self.status = OrderStatus.PLACED
        self.created_at = datetime.now()
        self.updated_at = self.created_at

    def update_status(self, new_status):
        # basic validation for state transitions
        valid_transitions = {
            OrderStatus.PLACED: [OrderStatus.PREPARING, OrderStatus.CANCELLED],
            OrderStatus.PREPARING: [OrderStatus.OUT_FOR_DELIVERY, OrderStatus.CANCELLED],
            OrderStatus.OUT_FOR_DELIVERY: [OrderStatus.DELIVERED, OrderStatus.CANCELLED],
            OrderStatus.DELIVERED: [],
            OrderStatus.CANCELLED: []
        }

        if new_status in valid_transitions[self.status]:
            self.status = new_status
            self.updated_at = datetime.now()
        else:
            raise ValueError(f"Invalid transition from {self.status} to {new_status}")

    def __repr__(self):
        return f"<Order {self.order_id} - {self.status.value}>"


# ---------------- DELIVERY CLASS (ADDED AFTER ORDER) ----------------
class Delivery:
    def __init__(self, order_id):
        self.order_id = order_id
        self.pickup_time = None
        self.delivery_time = None

    def mark_picked(self):
        self.pickup_time = datetime.now()

    def mark_delivered(self):
        self.delivery_time = datetime.now()

    def get_delivery_duration(self):
        if self.pickup_time and self.delivery_time:
            return (self.delivery_time - self.pickup_time).total_seconds()
        return None


# ---------------- ORDER MANAGER ----------------
class OrderManager:
    def __init__(self):
        self.orders = {}
        self.deliveries = {}

    def create_order(self, order):
        self.orders[order.order_id] = order

    def update_order_status(self, order_id, status):
        order = self.orders[order_id]
        order.update_status(status)

        # attach delivery when moving to OUT_FOR_DELIVERY
        if status == OrderStatus.OUT_FOR_DELIVERY:
            delivery = Delivery(order_id)
            delivery.mark_picked()
            self.deliveries[order_id] = delivery

        # mark delivery completion
        if status == OrderStatus.DELIVERED:
            if order_id in self.deliveries:
                self.deliveries[order_id].mark_delivered()

    # ---------------- STATISTICS ----------------
    def get_active_orders(self):
        return [o for o in self.orders.values() if o.status.is_active()]

    def get_closed_orders(self):
        return [o for o in self.orders.values() if o.status.is_closed()]

    def get_total_revenue(self):
        return sum(
            o.order_value for o in self.orders.values()
            if o.status == OrderStatus.DELIVERED
        )

    def get_orders_by_restaurant(self, restaurant_id):
        return [
            o for o in self.orders.values()
            if o.restaurant_id == restaurant_id
        ]

    def get_average_delivery_time_by_restaurant(self, restaurant_id):
        times = []

        for order in self.orders.values():
            if order.restaurant_id == restaurant_id and order.status == OrderStatus.DELIVERED:
                delivery = self.deliveries.get(order.order_id)
                if delivery:
                    duration = delivery.get_delivery_duration()
                    if duration:
                        times.append(duration)

        if not times:
            return 0

        return sum(times) / len(times)


# ---------------- TEST CLASS ----------------
class TestOrderManager:
    def run_tests(self):
        self.test_order_flow()
        self.test_revenue()
        self.test_average_delivery_time()

    def test_order_flow(self):
        print("\nRunning test_order_flow...")

        manager = OrderManager()
        o1 = Order(1, 101, 201, 500, 5)

        manager.create_order(o1)
        manager.update_order_status(1, OrderStatus.PREPARING)
        manager.update_order_status(1, OrderStatus.OUT_FOR_DELIVERY)
        manager.update_order_status(1, OrderStatus.DELIVERED)

        assert o1.status == OrderStatus.DELIVERED
        print("test_order_flow passed")

    def test_revenue(self):
        print("\nRunning test_revenue...")

        manager = OrderManager()
        o1 = Order(1, 101, 201, 500, 5)
        o2 = Order(2, 101, 202, 300, 3)

        manager.create_order(o1)
        manager.create_order(o2)

        manager.update_order_status(1, OrderStatus.PREPARING)
        manager.update_order_status(1, OrderStatus.OUT_FOR_DELIVERY)
        manager.update_order_status(1, OrderStatus.DELIVERED)

        manager.update_order_status(2, OrderStatus.CANCELLED)

        assert manager.get_total_revenue() == 500
        print("test_revenue passed")

    # ----------- NEW TEST (AS REQUESTED) -----------
    def test_average_delivery_time(self):
        print("\nRunning test_average_delivery_time...")

        manager = OrderManager()

        o1 = Order(1, 101, 201, 500, 5)
        o2 = Order(2, 101, 202, 300, 3)

        manager.create_order(o1)
        manager.create_order(o2)

        # simulate delivery for o1
        manager.update_order_status(1, OrderStatus.PREPARING)
        manager.update_order_status(1, OrderStatus.OUT_FOR_DELIVERY)

        # manually adjust time for realism
        manager.deliveries[1].pickup_time -= timedelta(minutes=30)

        manager.update_order_status(1, OrderStatus.DELIVERED)

        # simulate delivery for o2
        manager.update_order_status(2, OrderStatus.PREPARING)
        manager.update_order_status(2, OrderStatus.OUT_FOR_DELIVERY)
        manager.deliveries[2].pickup_time -= timedelta(minutes=20)
        manager.update_order_status(2, OrderStatus.DELIVERED)

        avg_time = manager.get_average_delivery_time_by_restaurant(101)

        print(f"Average delivery time (seconds): {avg_time}")
        assert avg_time > 0

        print("test_average_delivery_time passed")


# ---------------- MAIN ----------------
if __name__ == "__main__":
    tester = TestOrderManager()
    tester.run_tests()
