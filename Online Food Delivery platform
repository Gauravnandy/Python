from enum import Enum
from collections import defaultdict


class OrderStatus(Enum):
    PLACED = "placed"
    PREPARING = "preparing"
    OUT_FOR_DELIVERY = "out for delivery"
    DELIVERED = "delivered"
    CANCELLED = "cancelled"


class Order:
    def __init__(self, order_id, restaurant_id, customer_id, order_value, distance):
        self.order_id = order_id
        self.restaurant_id = restaurant_id
        self.customer_id = customer_id
        self.order_value = order_value
        self.distance = distance
        self.status = OrderStatus.PLACED

    def update_status(self, new_status):
        # Optional: enforce valid transitions
        valid_transitions = {
            OrderStatus.PLACED: [OrderStatus.PREPARING, OrderStatus.CANCELLED],
            OrderStatus.PREPARING: [OrderStatus.OUT_FOR_DELIVERY, OrderStatus.CANCELLED],
            OrderStatus.OUT_FOR_DELIVERY: [OrderStatus.DELIVERED],
            OrderStatus.DELIVERED: [],
            OrderStatus.CANCELLED: []
        }

        if new_status in valid_transitions[self.status]:
            self.status = new_status
        else:
            raise ValueError(f"Invalid transition from {self.status} to {new_status}")

    def __repr__(self):
        return f"Order({self.order_id}, Status={self.status.value})"


class OrderManager:
    def __init__(self):
        self.orders = {}

    def create_order(self, order_id, restaurant_id, customer_id, order_value, distance):
        if order_id in self.orders:
            raise ValueError("Order ID already exists")

        order = Order(order_id, restaurant_id, customer_id, order_value, distance)
        self.orders[order_id] = order
        return order

    def update_order_status(self, order_id, new_status):
        if order_id not in self.orders:
            raise ValueError("Order not found")

        self.orders[order_id].update_status(new_status)

    def get_order(self, order_id):
        return self.orders.get(order_id)

    def get_all_orders(self):
        return list(self.orders.values())

    # 📊 Statistics Methods
    def total_orders(self):
        return len(self.orders)

    def orders_by_status(self):
        stats = defaultdict(int)
        for order in self.orders.values():
            stats[order.status] += 1
        return dict(stats)

    def total_revenue(self):
        return sum(
            order.order_value for order in self.orders.values()
            if order.status == OrderStatus.DELIVERED
        )

    def average_order_value(self):
        if not self.orders:
            return 0
        return sum(order.order_value for order in self.orders.values()) / len(self.orders)

    def orders_by_restaurant(self):
        stats = defaultdict(int)
        for order in self.orders.values():
            stats[order.restaurant_id] += 1
        return dict(stats)


# 🚀 Example Usage
