    def create_order(self, order_id, restaurant_id, customer_id, value, distance):
        if order_id in self.orders:
            print("Order already exists!")
            return

        order = Order(order_id, restaurant_id, customer_id, value, distance)
        self.orders[order_id] = order

    def update_order_status(self, order_id, new_status):
        if order_id not in self.orders:
            print("Order not found!")
            return

        self.orders[order_id].update_status(new_status)

    def get_order(self, order_id):
        return self.orders.get(order_id, None)

    def get_all_orders(self):
        return list(self.orders.values())

    # ---- Statistics ----
    def get_active_orders(self):
        return [o for o in self.orders.values() if o.is_active()]

    def get_closed_orders(self):
        return [o for o in self.orders.values() if o.is_closed()]

    def total_revenue(self):
        return sum(o.value for o in self.orders.values() if o.status == OrderStatus.DELIVERED)

    def average_delivery_distance(self):
        delivered_orders = [o for o in self.orders.values() if o.status == OrderStatus.DELIVERED]
        if not delivered_orders:
            return 0
        return sum(o.distance for o in delivered_orders) / len(delivered_orders)

    def orders_by_restaurant(self):
        result = defaultdict(list)
        for o in self.orders.values():
            result[o.restaurant_id].append(o)
        return result

    def status_count(self):
        count = defaultdict(int)
        for o in self.orders.values():
            count[o.status] += 1
        return count


