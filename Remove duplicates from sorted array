class solution:
    def removeduplicate(self, nums):
        if len(nums) == 0:
            return 0

        k = 1
        for i in range(1, len(nums)):
            if nums[i] != nums[i-1]:
                nums[k] = nums[i]
                k+=1
        return k

obj = solution()
nums = [1,1,2,2,2,3,1,3,4,9]
result = obj.removeduplicate(nums)
print("Number of unique elements are :", result)
print("The updated array is :", nums[:result])



     
