class solution:
    def lengthofsubstring(self, s: str) -> int:
        left = 0
        max_len = 0
        seen = set()

        for right in range(len(s)):
            while s[right] in seen:
                seen.remove (s[left])
                left += 1
            seen.add (s[right])
            max_len = max(max_len, right - left +1)

        return max_len

obj= solution()

s = input("enter a string : ")

result = obj.lenghtofsubstring(s)

print("the longest substring", result)



